{
  "name": "edge-addon",
  "version": "2.1.0",
  "description": "Publish add-on to Microsoft Edge Add-ons.",
  "author": "hyperbola",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdzeng/edge-addon"
  },
  "scripts": {
    "test": "pnpm test:unit-test && pnpm test:upload",
    "test:unit-test": "vitest run --silent",
    "test:upload": "node -r dotenv/config test/upload.ts dotenv_config_path=test/.env.local",
    "lint": "eslint --fix"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "axios": "^1.15.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.12.2",
    "@types/tmp": "^0.2.6",
    "adm-zip": "^0.5.17",
    "axios-mock-adapter": "^2.1.0",
    "dotenv": "^17.4.1",
    "eslint": "^10.2.0",
    "eslint-config-wdzeng": "github:wdzeng/eslint-config#semver:^0.16.0",
    "prettier": "^3.8.2",
    "tmp": "^0.2.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "type": "module",
  "imports": {
    "##/*": "./*",
    "#/*": "./src/*.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
