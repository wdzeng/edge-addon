// https://www.totaltypescript.com/tsconfig-cheat-sheet
{
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "lib": ["es2024"],
    "paths": {
      "##/*": ["./*"],
      "#/*": ["./src/*"]
    },

    // This should be optional. But I don't know why omitting it makes ESLint fail to recognize
    // global functions e.g. `console.log`.
    "types": ["node"]
  }
}
